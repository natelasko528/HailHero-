# HailHero MVP Environment Configuration
# Generated for development/testing

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
ENVIRONMENT=development
FLASK_APP=src/mvp/app.py
FLASK_ENV=development
SECRET_KEY=dev-secret-key-change-in-production-12345678
HOST=0.0.0.0
PORT=5000
DEBUG=True

# =============================================================================
# DATABASE SETTINGS
# =============================================================================
# SQLite for development (default)
DATABASE_URL=sqlite:///data/hailhero.db

# PostgreSQL for production (uncomment when using docker-compose)
# DATABASE_URL=postgresql://hailhero:hailhero123@localhost:5432/hailhero
POSTGRES_PASSWORD=hailhero123

# =============================================================================
# REDIS SETTINGS
# =============================================================================
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# NOAA/NCEI API SETTINGS
# =============================================================================
# Get token from: https://www.ncdc.noaa.gov/cdo-web/token
NCEI_TOKEN=your-ncei-token-here-optional-for-testing
NOAA_API_KEY=your-noaa-api-key-optional

# =============================================================================
# TWILIO SETTINGS
# =============================================================================
# Get credentials from: https://console.twilio.com
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+15555555555

# =============================================================================
# GOHIGHLEVEL SETTINGS
# =============================================================================
GHL_API_KEY=your-gohighlevel-api-key
GHL_LOCATION_ID=your-gohighlevel-location-id

# =============================================================================
# LOGGING SETTINGS
# =============================================================================
LOG_LEVEL=DEBUG
LOG_FILE=logs/hailhero.log

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://127.0.0.1:5000
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# =============================================================================
# CELERY SETTINGS
# =============================================================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# =============================================================================
# DATA PROCESSING SETTINGS
# =============================================================================
ENABLE_PROPERTY_ENRICHMENT=true
MAX_PROPERTIES_PER_EVENT=50
HAIL_MIN_SIZE=0.5
WIND_MIN_SPEED=60.0

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_CACHING=true
ENABLE_SCHEDULING=true
ENABLE_OPENADDRESSES=true
ENABLE_METRICS=true
